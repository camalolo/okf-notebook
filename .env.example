# Notebook configuration — copy to .env and fill in what you need.
# Every variable is optional unless marked required; the app degrades
# gracefully (no OAuth creds → no login; no search keys → no web_search; …).

# --- Server -------------------------------------------------------------------
# PORT=3002
# HOST=127.0.0.1
# Required in production. Generate one: openssl rand -hex 32
# SESSION_SECRET=change-me
# IANA timezone used for the chat system prompt's date/time stamp and as the
# digest scheduler's default. Defaults to the server's own timezone.
# TIMEZONE=Asia/Taipei

# --- Login (Google OAuth) -----------------------------------------------------
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# and add "https://<your-domain>/api/notebook/auth/google/callback" as an
# authorized redirect URI (http://localhost:5173/... works for dev).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Who may log in, as email:role pairs (role = full | readonly).
# `full` users can edit files, commit, and manage settings; `readonly` users
# can read, search, and chat without write tools.
# NOTEBOOK_USERS=me@example.com:full,friend@example.com:readonly

# --- LLM backend (any OpenAI-compatible API) ----------------------------------
# Base URL up to and including the version segment, no trailing slash.
#   Z.ai:        https://api.z.ai/api/paas/v4
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://127.0.0.1:11434/v1
# Defaults to a local inference proxy at http://127.0.0.1:3003/api/v1.
# LLM_BASE_URL=https://api.openai.com/v1
# API key sent as `Authorization: Bearer …`.
# LLM_API_KEY=
# Default model id (can be changed later in the app's Settings page).
# LLM_MODEL=glm-5.2
# Optional regex restricting which model ids the Settings dropdown offers,
# e.g. to stay on curated providers behind a routing proxy.
# LLM_MODELS_FILTER=^(glm-|deepseek-(chat|reasoner)$)

# --- Web search (web_search tool) ----------------------------------------------
# Any one (or more) enables it; tried in this order on fallback.
# EXA_API_KEY=
# TAVILY_API_KEY=
# TINYFISH_API_KEY=
# SERPER_API_KEY=

# --- Daily digest email ---------------------------------------------------------
# Disabled unless DIGEST_TO is set. Mail is submitted unauthenticated to a
# local SMTP relay by default — point DIGEST_SMTP_* at your MTA.
# DIGEST_TO=me@example.com
# DIGEST_FROM=notebook-digest@example.com
# DIGEST_SMTP_HOST=127.0.0.1
# DIGEST_SMTP_PORT=25
# DIGEST_CRON=0 8 * * *
# DIGEST_TZ=
# DIGEST_DISABLED=1

# --- Deploy script (scripts/deploy.mjs) ------------------------------------------
# Target directory for `npm run deploy`. Not needed for local dev.
# DEPLOY_DIR=/srv/notebook

# --- MCP servers ---------------------------------------------------------------
# MCP servers are managed at runtime from the app: Settings → "MCP servers"
# (persisted in server/data/mcps.json; nothing ships by default). Example
# servers that work well: the Google Workspace MCP (per-user, name must be
# "google-workspace" for token isolation), @playwright/mcp (headless browser),
# and the third-party read-only IBKR reports server (MIT):
#   https://github.com/0xmichalis/ibkr-flex-mcp
# (download its release binary into bin/ and reference it as `bin/ibkr-flex-mcp`
# with IBKR_FLEX_TOKEN / IBKR_FLEX_QUERY_ID passed via its env fields).

# Context window (tokens) of LLM_MODEL, for the chat context indicator's
# colouring. Auto-derived for known families (glm → 1M, deepseek → 128K);
# set this to override for other backends.
# LLM_CONTEXT_LIMIT=1000000
